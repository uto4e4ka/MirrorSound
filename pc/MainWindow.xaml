<Window x:Class="MirrorSound.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorSound"
        Width="400" Height="716"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="#0E0F13"
        Foreground="#ECEEF2"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Card" Color="#171920" />
        <SolidColorBrush x:Key="CardBorder" Color="#23262F" />
        <SolidColorBrush x:Key="Muted" Color="#8A909C" />

        <!-- Sound-waves glyph, same as the app icon -->
        <Geometry x:Key="WavesDot">M18,36 A6,6 0 1 1 30,36 A6,6 0 1 1 18,36 Z</Geometry>
        <Geometry x:Key="Waves">M33.64,24.51 A15,15 0 0 1 33.64,47.49 M40.07,16.85 A25,25 0 0 1 40.07,55.15 M46.5,9.19 A35,35 0 0 1 46.5,62.81</Geometry>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="#A5B4FC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Accent}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Knob" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="18" Height="18" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="#2A2D36" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFill}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackRest}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Knob}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#ECEEF2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11"
                                    Background="#2A2D36">
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#C9CCD4"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1E2029" BorderBrush="#2E313B" BorderThickness="1"
                                CornerRadius="10" Padding="6">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#ECEEF2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Padding="12,8" CornerRadius="6" Background="Transparent">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E313B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Accent}">
                <Viewbox Margin="9">
                    <Canvas Width="72" Height="72">
                        <Path Data="{StaticResource WavesDot}" Fill="White" />
                        <Path Data="{StaticResource Waves}" Stroke="White" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MirrorSound" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Звук телефона на компьютере" FontSize="13" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="1" Margin="0,20,0,0" Padding="16,14" CornerRadius="16"
                Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Ellipse x:Name="PulseRing" Width="22" Height="22" Fill="#22C55E" Opacity="0"
                             RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" ScaleX="0.4" ScaleY="0.4" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.4" To="1" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.4" To="1" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F59E0B" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="StatusText" Text="Запуск…" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DeviceText" Text="Телефон ещё не подключён" FontSize="12.5"
                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area: QR while waiting, level meter while playing -->
        <Grid Grid.Row="2" Margin="0,18,0,18">
            <StackPanel x:Name="QrPanel" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="22" Padding="18" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#8B5CF6" BlurRadius="40" ShadowDepth="0" Opacity="0.35" />
                    </Border.Effect>
                    <Image x:Name="QrImage" Width="210" Height="210" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Text="Наведите камеру телефона на код" HorizontalAlignment="Center"
                           FontSize="14" Margin="0,18,0,0" />
                <TextBlock Text="или отсканируйте его в приложении MirrorSound" HorizontalAlignment="Center"
                           FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                <Button x:Name="HideQrButton" Style="{StaticResource Link}" Content="Скрыть QR-код"
                        HorizontalAlignment="Center" Margin="0,10,0,0" Padding="6,2" Visibility="Collapsed"
                        Click="ToggleQr" />
            </StackPanel>

            <StackPanel x:Name="PlayingPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid Width="150" Height="150" HorizontalAlignment="Center">
                    <Ellipse Fill="{StaticResource Accent}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#7C6CFF" BlurRadius="50" ShadowDepth="0" Opacity="0.6" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Viewbox Margin="40">
                        <Canvas Width="72" Height="72">
                            <Path Data="{StaticResource WavesDot}" Fill="White" />
                            <Path Data="{StaticResource Waves}" Stroke="White" StrokeThickness="6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Grid>
                <Canvas x:Name="Meter" Height="70" Margin="0,30,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource Link}" Content="Показать QR-код" HorizontalAlignment="Center"
                        Margin="0,16,0,0" Padding="6,2" Click="ToggleQr" />
            </StackPanel>
        </Grid>

        <!-- Network -->
        <Grid Grid.Row="3" Margin="2,0,2,14">
            <TextBlock Text="Сеть" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
            <Button x:Name="NetworkButton" Style="{StaticResource Link}" HorizontalAlignment="Right"
                    Padding="4,2" Click="ShowNetworks" />
        </Grid>

        <!-- Volume + startup -->
        <Border Grid.Row="4" Padding="16,12" CornerRadius="16"
                Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="12,0,8,0" Minimum="0" Maximum="100"
                        Value="100" Style="{StaticResource VolumeSlider}" VerticalAlignment="Center"
                        ValueChanged="VolumeChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="100%" FontSize="13"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,12" />
            <CheckBox x:Name="AutostartToggle" Style="{StaticResource Switch}"
                      Checked="AutostartChanged" Unchecked="AutostartChanged">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="Запускать вместе с Windows" FontSize="13.5" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
