<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MirrorSound.MainWindow"
        Title="MirrorSound"
        Width="400" Height="690"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.png"
        Background="#0E0F13"
        Foreground="#ECEEF2"
        FontFamily="{StaticResource InterFont}">

    <Window.Resources>
        <FontFamily x:Key="InterFont">fonts:Inter#Inter, $Default</FontFamily>
        <LinearGradientBrush x:Key="Accent" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Card" Color="#171920" />
        <SolidColorBrush x:Key="CardBorder" Color="#23262F" />
        <SolidColorBrush x:Key="Muted" Color="#8A909C" />

        <!-- Sound-waves glyph, same as the app icon -->
        <StreamGeometry x:Key="WavesDot">M18,36 A6,6 0 1 1 30,36 A6,6 0 1 1 18,36 Z</StreamGeometry>
        <StreamGeometry x:Key="Waves">M33.64,24.51 A15,15 0 0 1 33.64,47.49 M40.07,16.85 A25,25 0 0 1 40.07,55.15 M46.5,9.19 A35,35 0 0 1 46.5,62.81</StreamGeometry>
        <StreamGeometry x:Key="Speaker">M3,9 L7,9 L12,4.5 L12,19.5 L7,15 L3,15 Z</StreamGeometry>
        <StreamGeometry x:Key="SpeakerWaves">M15.5,8.8 A4.5,4.5 0 0 1 15.5,15.2 M18,6.3 A8,8 0 0 1 18,17.7</StreamGeometry>
        <StreamGeometry x:Key="Power">M12,3.5 L12,11 M7.4,6.6 A7,7 0 1 0 16.6,6.6</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.link">
            <Setter Property="Foreground" Value="#A5B4FC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Slider.volume">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Height="24" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="#2A2D36" VerticalAlignment="Center" />
                        <Track Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                    Background="{DynamicResource Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="White"
                                                BoxShadow="0 1 8 0 #80000000" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox.switch">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                        <Border Name="track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#2A2D36">
                            <Border Name="knob" Width="16" Height="16" CornerRadius="8" Background="#C9CCD4"
                                    HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.Transitions>
                                    <Transitions>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.switch:checked /template/ Border#track">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="CheckBox.switch:checked /template/ Border#knob">
            <Setter Property="Background" Value="White" />
            <Setter Property="RenderTransform" Value="translateX(18px)" />
        </Style>

        <Style Selector="Ellipse#PulseRing">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.4" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid Margin="24,18,24,22" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Accent}">
                <Viewbox Margin="9">
                    <Canvas Width="72" Height="72">
                        <Path Data="{StaticResource WavesDot}" Fill="White" />
                        <Path Data="{StaticResource Waves}" Stroke="White" StrokeThickness="6" StrokeLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MirrorSound" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Звук телефона на компьютере" FontSize="13" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="1" Margin="0,20,0,0" Padding="16,14" CornerRadius="16"
                Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Ellipse Name="PulseRing" Width="22" Height="22" Fill="#22C55E" Opacity="0" IsVisible="False">
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Name="StatusDot" Width="10" Height="10" Fill="#F59E0B" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Name="StatusText" Text="Запуск…" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="DeviceText" Text="Телефон ещё не подключён" FontSize="12.5"
                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area: QR while waiting, level meter while playing -->
        <Grid Grid.Row="2" Margin="0,18,0,18">
            <StackPanel Name="QrPanel" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="22" Padding="18" HorizontalAlignment="Center"
                        BoxShadow="0 0 40 0 #598B5CF6">
                    <Image Name="QrImage" Width="210" Height="210" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <TextBlock Text="Наведите камеру телефона на код" HorizontalAlignment="Center"
                           FontSize="14" Margin="0,18,0,0" />
                <TextBlock Text="или отсканируйте его в приложении MirrorSound" HorizontalAlignment="Center"
                           FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                <Button Name="HideQrButton" Classes="link" Content="Скрыть QR-код"
                        HorizontalAlignment="Center" Margin="0,10,0,0" Padding="6,2" IsVisible="False"
                        Click="ToggleQr" />
            </StackPanel>

            <StackPanel Name="PlayingPanel" VerticalAlignment="Center" IsVisible="False">
                <Border Width="150" Height="150" CornerRadius="75" HorizontalAlignment="Center"
                        Background="{StaticResource Accent}" BoxShadow="0 0 50 0 #997C6CFF">
                    <Viewbox Margin="40">
                        <Canvas Width="72" Height="72">
                            <Path Data="{StaticResource WavesDot}" Fill="White" />
                            <Path Data="{StaticResource Waves}" Stroke="White" StrokeThickness="6" StrokeLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Canvas Name="Meter" Height="70" Margin="0,30,0,0" HorizontalAlignment="Center" />
                <Button Classes="link" Content="Показать QR-код" HorizontalAlignment="Center"
                        Margin="0,16,0,0" Padding="6,2" Click="ToggleQr" />
            </StackPanel>
        </Grid>

        <!-- Network -->
        <Grid Grid.Row="3" Margin="2,0,2,14">
            <TextBlock Text="Сеть" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" />
            <Button Name="NetworkButton" Classes="link" HorizontalAlignment="Right" Padding="4,2" Click="ShowNetworks" />
        </Grid>

        <!-- Volume + startup -->
        <Border Grid.Row="4" Padding="16,12" CornerRadius="16"
                Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,44">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Speaker}" Fill="{StaticResource Muted}" />
                            <Path Data="{StaticResource SpeakerWaves}" Stroke="{StaticResource Muted}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <Slider Name="VolumeSlider" Grid.Column="1" Margin="12,0,8,0" Minimum="0" Maximum="100"
                            Value="100" Classes="volume" VerticalAlignment="Center" />
                    <TextBlock Name="VolumeText" Grid.Column="2" Text="100%" FontSize="13"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,12" />
                <CheckBox Name="AutostartToggle" Classes="switch">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Power}" Stroke="{StaticResource Muted}" StrokeThickness="2"
                                      StrokeLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Запускать при входе в систему" FontSize="13.5" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
